{
  "actions": {
    "AcquireSandboxInstanceToken": {
      "document": "获取访问沙箱工具时所需要使用的访问Token，创建沙箱实例后需调用此接口获取沙箱实例访问Token。\n此Token可用于调用代码沙箱实例执行代码，或浏览器沙箱实例进行浏览器操作等。",
      "input": "AcquireSandboxInstanceTokenRequest",
      "name": "获取沙箱实例的访问Token",
      "output": "AcquireSandboxInstanceTokenResponse",
      "status": "online"
    },
    "DescribeSandboxInstanceList": {
      "document": "查询沙箱实例列表",
      "input": "DescribeSandboxInstanceListRequest",
      "name": "查询沙箱实例列表",
      "output": "DescribeSandboxInstanceListResponse",
      "status": "online"
    },
    "PauseSandboxInstance": {
      "document": "暂停沙箱实例",
      "input": "PauseSandboxInstanceRequest",
      "name": "暂停沙箱实例",
      "output": "PauseSandboxInstanceResponse",
      "status": "online"
    },
    "ResumeSandboxInstance": {
      "document": "恢复沙箱实例",
      "input": "ResumeSandboxInstanceRequest",
      "name": "恢复沙箱实例",
      "output": "ResumeSandboxInstanceResponse",
      "status": "online"
    },
    "StartSandboxInstance": {
      "document": "启动沙箱实例",
      "input": "StartSandboxInstanceRequest",
      "name": "启动沙箱实例",
      "output": "StartSandboxInstanceResponse",
      "status": "online"
    },
    "StopSandboxInstance": {
      "document": "停止沙箱实例",
      "input": "StopSandboxInstanceRequest",
      "name": "停止沙箱实例",
      "output": "StopSandboxInstanceResponse",
      "status": "online"
    },
    "UpdateSandboxInstance": {
      "document": "更新沙箱实例",
      "input": "UpdateSandboxInstanceRequest",
      "name": "更新沙箱实例",
      "output": "UpdateSandboxInstanceResponse",
      "status": "online"
    }
  },
  "metadata": {
    "apiVersion": "2025-09-20",
    "api_brief": "Agent Sandbox 沙箱管理与调用",
    "serviceNameCN": "Agent 沙箱服务",
    "serviceShortName": "ags"
  },
  "objects": {
    "AcquireSandboxInstanceTokenRequest": {
      "document": "AcquireSandboxInstanceToken请求参数结构体",
      "members": [
        {
          "disabled": false,
          "document": "\u003cp\u003e沙箱实例ID，生成的访问Token将仅可用于访问此沙箱实例\u003c/p\u003e",
          "example": "a123478903213307971e7bc5793",
          "member": "string",
          "name": "InstanceId",
          "required": true,
          "type": "string"
        }
      ],
      "type": "object"
    },
    "AcquireSandboxInstanceTokenResponse": {
      "document": "AcquireSandboxInstanceToken返回参数结构体",
      "members": [
        {
          "disabled": false,
          "document": "\u003cp\u003e访问Token\u003c/p\u003e",
          "example": "sit_1XXJWXVbosp4ZeSSlnZBMs4wsWirZtx3Ixp1Ndz2_gQ",
          "member": "string",
          "name": "Token",
          "output_required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e过期时间\u003c/p\u003e",
          "example": "2025-09-12T09:00:03.094Z",
          "member": "string",
          "name": "ExpiresAt",
          "output_required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e非管控面（envd）的访问Token\u003c/p\u003e",
          "example": "f0XXXXX077d7d61862e0f144568bd2c207cbbbbe94eb5ef919f884dc614796ab",
          "member": "string",
          "name": "TrafficToken",
          "output_required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "document": "唯一请求 ID，由服务端生成，每次请求都会返回（若请求因其他原因未能抵达服务端，则该次请求不会获得 RequestId）。定位问题时需要提供该次请求的 RequestId。",
          "member": "string",
          "name": "RequestId",
          "type": "string"
        }
      ],
      "type": "object"
    },
