    "SandboxInstance": {
      "document": "沙箱实例结构体",
      "members": [
        {
          "disabled": false,
          "document": "\u003cp\u003e沙箱实例唯一标识符\u003c/p\u003e",
          "example": "48dd1132cfb96ccee5fd0aa58da2562d2fe3a929",
          "member": "string",
          "name": "InstanceId",
          "output_required": true,
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e所属沙箱工具 ID\u003c/p\u003e",
          "example": "sdt-def456ghi789",
          "member": "string",
          "name": "ToolId",
          "output_required": true,
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e所属沙箱工具名称\u003c/p\u003e",
          "example": "code-interpreter-v1",
          "member": "string",
          "name": "ToolName",
          "output_required": true,
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e实例状态：STARTING（启动中）、RUNNING（运行中）、STOPPING（停止中）、STOPPED（已停止）、STOP_FAILED（停止失败）、FAILED（失败状态）\u003c/p\u003e",
          "example": "RUNNING",
          "member": "string",
          "name": "Status",
          "output_required": true,
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e是否常驻实例\u003c/p\u003e",
          "example": "false",
          "member": "bool",
          "name": "Persistent",
          "output_required": false,
          "required": false,
          "type": "bool",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e超时时间（秒），null 表示无超时设置\u003c/p\u003e",
          "example": "600",
          "member": "uint64",
          "name": "TimeoutSeconds",
          "output_required": false,
          "required": false,
          "type": "int",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e过期时间（ISO 8601 格式），null 表示无过期时间\u003c/p\u003e",
          "example": "2024-01-01T10:30:00Z",
          "member": "string",
          "name": "ExpiresAt",
          "output_required": false,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e停止原因：manual（手动）、timeout（超时）、error（错误）、system（系统），仅在状态为 STOPPED、STOP_FAILED 或 FAILED 时有值。当 provider 停止失败时，状态为 STOP_FAILED，原因为 error\u003c/p\u003e",
          "example": "timeout",
          "member": "string",
          "name": "StopReason",
          "output_required": false,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e创建时间（ISO 8601 格式）\u003c/p\u003e",
          "example": "2024-01-01T10:00:00Z",
          "member": "string",
          "name": "CreateTime",
          "output_required": false,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e更新时间（ISO 8601 格式）\u003c/p\u003e",
          "example": "2024-01-01T10:10:00Z",
          "member": "string",
          "name": "UpdateTime",
          "output_required": false,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e存储挂载选项\u003c/p\u003e",
          "example": "无",
          "member": "MountOption",
          "name": "MountOptions",
          "output_required": false,
          "required": false,
          "type": "list",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e沙箱实例自定义配置\u003c/p\u003e",
          "example": "无",
          "member": "CustomConfigurationDetail",
          "name": "CustomConfiguration",
          "output_required": false,
          "required": false,
          "type": "object",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e桌面电脑环境类沙箱配置\u003c/p\u003e",
          "example": "无",
          "member": "ComputerConfiguration",
          "name": "ComputerConfiguration",
          "output_required": false,
          "required": false,
          "type": "object",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e网络模式\u003c/p\u003e\u003cp\u003e枚举值：\u003c/p\u003e\u003cul\u003e\u003cli\u003ePUBLIC： 公网访问\u003c/li\u003e\u003cli\u003eSANDBOX： 无网络\u003c/li\u003e\u003cli\u003eINTERNAL_SERVICE： 腾讯云内部公共服务\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e可以覆盖工具级别的网络配置。但如果一个工具本身就不支持 VPC 网络，那么即便在实例设置里选了 VPC 模式，也是无效的\u003c/p\u003e",
          "example": "VPC",
          "member": "string",
          "name": "NetworkMode",
          "output_required": false,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e沙箱实例元数据\u003c/p\u003e",
          "example": "无",
          "member": "MetadataVar",
          "name": "Metadata",
          "output_required": false,
          "required": false,
          "type": "list",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "\u003cp\u003e沙箱访问认证模式\u003c/p\u003e\u003cp\u003e枚举值：\u003c/p\u003e\u003cul\u003e\u003cli\u003eDEFAULT： 默认，即 TOKEN 认证\u003c/li\u003e\u003cli\u003eTOKEN： Token认证，即所有端口访问都需携带TOKEN\u003c/li\u003e\u003cli\u003eNONE： 免认证，即所有端口访问无需携带TOKEN\u003c/li\u003e\u003cli\u003ePUBLIC： 公开模式，即ENVD管理端口（49983）访问需携带TOKEN，其他端口无需携带TOKEN\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e默认值：DEFAULT\u003c/p\u003e",
          "example": "TOKEN",
          "member": "string",
          "name": "AuthMode",
          "output_required": false,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        }
      ],
      "usage": "both"
    },
