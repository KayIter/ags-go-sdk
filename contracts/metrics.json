{
  "schema_version": 1,
  "service": "monitor",
  "version": "2018-07-24",
  "action": "GetMonitorData",
  "endpoint": "monitor.tencentcloudapi.com",
  "namespace": "QCE/AGS",
  "dimensions": ["instance_id", "tool_id"],
  "default_window_seconds": 172800,
  "default_period_seconds": 300,
  "max_concurrency": 4,
  "metrics": [
    {"name":"SandboxCpuUsagePercent","source_metric_name":"sandbox_cpu_usage_percent","unit":"PERCENT"},
    {"name":"SandboxCpuUsedCores","source_metric_name":"sandbox_cpu_used_cores","unit":"CORES"},
    {"name":"SandboxDiskReadBytesPerSecond","source_metric_name":"sandbox_disk_read_bytes_per_second","unit":"BYTES_PER_SECOND"},
    {"name":"SandboxDiskWriteBytesPerSecond","source_metric_name":"sandbox_disk_write_bytes_per_second","unit":"BYTES_PER_SECOND"},
    {"name":"SandboxFsUsagePercent","source_metric_name":"sandbox_fs_usage_percent","unit":"PERCENT"},
    {"name":"SandboxFsUsedBytes","source_metric_name":"sandbox_fs_used_bytes","unit":"BYTES"},
    {"name":"SandboxMemoryUsagePercent","source_metric_name":"sandbox_memory_usage_percent","unit":"PERCENT"},
    {"name":"SandboxMemoryUsedBytes","source_metric_name":"sandbox_memory_used_bytes","unit":"BYTES"},
    {"name":"SandboxNetworkRxBytesPerSecond","source_metric_name":"sandbox_network_rx_bytes_per_second","unit":"BYTES_PER_SECOND"},
    {"name":"SandboxNetworkTxBytesPerSecond","source_metric_name":"sandbox_network_tx_bytes_per_second","unit":"BYTES_PER_SECOND"}
  ]
}
